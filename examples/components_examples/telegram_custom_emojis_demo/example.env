TELEGRAM_BOT_TOKEN=your_bot_token_here

BOTSPOT_TELEGRAM_CUSTOM_EMOJIS_ENABLED=true
# random | StaticEmoji | CuteEmoji,StaticEmoji
BOTSPOT_TELEGRAM_CUSTOM_EMOJIS_PACK=random
# message picks a pack per send. process picks once until restart.
BOTSPOT_TELEGRAM_CUSTOM_EMOJIS_RANDOM_SCOPE=message
BOTSPOT_TELEGRAM_CUSTOM_EMOJIS_ALLOW_OTHER_PACKS=true
